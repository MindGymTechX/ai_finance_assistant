# --- Required ---
OPENAI_API_KEY=sk-...            # OpenAI key used for chat and embeddings

# --- Optional (defaults come from config.yaml) ---
# OPENAI_BASE_URL=               # set to use an OpenAI-compatible endpoint
# FINAI_CHAT_MODEL=gpt-4o-mini   # model for router, agents, synthesizer
# FINAI_EMBED_MODEL=text-embedding-3-small
# FINAI_TEMPERATURE=0.2
# FINAI_DATA_DIR=.finai          # where SQLite files and the vector index live
# FINAI_LOG_LEVEL=INFO
